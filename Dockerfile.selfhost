# multibot: public surface is harness only; supervisor starts engine on 127.0.0.1.
FROM node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip git xvfb curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
RUN python3 -m venv engine/.venv \
 && engine/.venv/bin/pip install --no-cache-dir -r engine/requirements.txt \
 && git clone --filter=blob:none https://github.com/NousResearch/hermes-agent engine/hermes-agent \
 && git -C engine/hermes-agent checkout 17688f9 \
 && engine/.venv/bin/pip install --no-cache-dir -e engine/hermes-agent \
 && engine/.venv/bin/python -m playwright install --with-deps chromium \
 && pnpm build \
 && pnpm build:server
ENV HOME=/data OMB_HOST=0.0.0.0 OMB_PORT=8799 \
    SLAFY_DATA_DIR=/data/engine-data HERMES_HOME=/data/.openmausbot \
    SLAFY_BROWSER_HEADLESS=1
VOLUME ["/data"]
EXPOSE 8799
ENTRYPOINT ["bash", "/app/scripts/docker-entrypoint.sh"]
