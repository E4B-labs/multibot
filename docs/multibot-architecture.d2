# MultiBot backend map. Open in D2/Obsidian or use the interactive HTML twin.
direction: right

UI: "React / PWA"
UI.Chat: "ChatView\ncomposer + stream"
UI.Sidebar: "Sidebar\nbots + groups"
UI.Panels: "Computer / Memory\nRoutines / Skills"
UI.Settings: "Settings + onboarding\nmodel + CLI login"

Harness: "Node/TypeScript harness\n127.0.0.1:8799"
Harness.API: "server/index.ts\nHTTP routes + startTurn"
Harness.Auth: "auth.ts\nBearer + WS auth"
Harness.Store: "store.ts / group-store.ts\nstate + transcripts"
Harness.Policy: "turn-policy.ts / workspace.ts\npermissions + context"
Harness.Routines: "routines.ts\npersisted scheduler"
Harness.Agents: "agents-proxy.ts\nlocal stdio tools"
Harness.Drivers: "driver registry\nClaude / Codex / ACP / local"
Harness.Proxy: "engine/proxy.ts\nHTTP + WebSocket bridge"

Providers: "Provider adapters"
Providers.Claude: "Claude CLI\npersistent session"
Providers.Codex: "Codex JSON-RPC\nresume session"
Providers.ACP: "ACP CLIs\nGemini / Grok / Kimi / Qwen"
Providers.Slafy: "Local adapter\nengine stream"

Engine: "Python agent engine\n127.0.0.1:8700"
Engine.App: "server/app.py\nFastAPI routes"
Engine.Gateway: "gateway.py\nHermes runtime + stream"
Engine.Bots: "bots.py\nprofiles + identity"
Engine.Modules: "memory / skills / routines\ncomputer / groups / files"
Engine.Provider: "providers.py\nlocal/custom endpoint"

Tools: "Agent capabilities"
Tools.Agents: "bot-to-bot + groups"
Tools.Files: "read/write + terminal"
Tools.Memory: "memory + skills + routines"
Tools.Computer: "browser MCP\nper-bot/shared lock"

Data: "Persistent state"
Data.Config: "config.json\ninstances + auth token"
Data.Store: "DATA_DIR\nroutines.json + bot records"
Data.Profiles: "engine-data/profiles/<bot>\nSOUL / memory / sessions"

UI.Chat -> Harness.API: "POST chat / SSE"
UI.Sidebar -> Harness.Store: "bot/group selection"
UI.Panels -> Harness.API: "panel routes"
UI.Settings -> Harness.API: "settings + auth"
Harness.Auth -> Harness.API: "guard HTTP + WS"
Harness.API -> Harness.Policy: "build turn context"
Harness.API -> Harness.Store: "append + resume cursor"
Harness.API -> Harness.Drivers: "startTurn"
Harness.API -> Harness.Routines: "create / run / tick"
Harness.API -> Harness.Agents: "internal agent actions"
Harness.Drivers -> Providers: "adapter selection"
Harness.Proxy -> Engine.App: "loopback HTTP / WS"
Harness.Agents -> Tools: "stdio JSON-RPC"
Providers.Slafy -> Harness.Proxy: "engine chat stream"
Providers.Claude -> Harness.Agents: "mount local tools"
Providers.Codex -> Harness.Agents: "mount local tools"
Providers.ACP -> Harness.Agents: "mount local tools"
Engine.App -> Engine.Gateway: "ensure gateway + routes"
Engine.Gateway -> Engine.Bots: "profile + identity"
Engine.Gateway -> Engine.Modules: "tools / memory / skills"
Engine.Gateway -> Engine.Provider: "model request"
Engine.Modules -> Tools: "capability execution"
Harness.Store -> Data.Store: "records + messages"
Harness.Auth -> Data.Config: "token"
Harness.Drivers -> Data.Config: "instance config"
Engine.Bots -> Data.Profiles: "profile files"
Engine.Modules -> Data.Profiles: "memory + skills"
Harness.Routines -> Data.Store: "durable schedule"

Flow: "Request path" {
  UI.Chat -> Harness.API -> Harness.Policy -> Harness.Drivers -> Engine.App -> Engine.Gateway -> Engine.Provider
}
