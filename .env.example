# Optional Vite build-time analytics key. Leave empty to disable analytics.
VITE_POSTHOG_KEY=

# Engine/runtime values belong in engine/.env, not in this file.

# ---------------------------------------------------------------------------
# Harness (server/) reads the variables below straight from the process
# environment — nothing in this repo loads a .env file for them. They are
# listed here as NAMES ONLY so nobody has to grep the source. Never commit
# values: this repository is public.
# ---------------------------------------------------------------------------

# Sieć i dane
# OMB_PORT                   port nasłuchu harnessa (domyślnie 8799)
# OMB_HOST                   interfejs nasłuchu (0.0.0.0 tylko świadomie)
# OMB_DATA_DIR               katalog danych (profile botów, czaty, konfiguracja)
# OMB_PUBLIC_URL             publiczny adres instancji w linkach i webhookach
# OMB_HARNESS_URL            adres harnessa dla proxy agentów i komputera bota

# Silnik i komputer bota
# MULTIBOT_ENGINE            włącza/wyłącza silnik Python (brak = graceful absence)
# MULTIBOT_COMPUTER_BACKEND  backend komputera bota
# MULTIBOT_HARNESS_TOKEN     token, którym silnik i MCP wołają harness

# Klucze dostawców modeli (sekrety — wartości wyłącznie w środowisku)
# ANTHROPIC_API_KEY
# OPENAI_API_KEY
# XAI_API_KEY
# OPENCODE_API_KEY
# COMPOSIO_KEY
